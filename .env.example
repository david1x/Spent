# Spent - Personal Finance Tracker
# Copy this file to .env and fill in your values.
# This file is committed to git as a template. Never commit .env itself.

# Optional: Override the default host/port for the dev server
# HOST=127.0.0.1
# PORT=4005

# Docker only, with docker-compose.screen.yml: the password for the screen
# you watch bank syncs on (6 to 8 characters).
# SPENT_SCREEN_PASSWORD=
# SPENT_SCREEN_PORT=6080
# SPENT_SCREEN_SIZE=1366x900
